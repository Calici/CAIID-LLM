ARG CUDA_VERSION_MAJOR=13
ARG CUDA_VERSION_MINOR=0
ARG CUDA_VERSION_PATCH=2
# Build llama.cpp server with CUDA support for production deployments
FROM nvidia/cuda:${CUDA_VERSION_MAJOR}.${CUDA_VERSION_MINOR}.${CUDA_VERSION_PATCH}-devel-ubuntu24.04 AS builder

ARG CUDA_VERSION_MAJOR=13
ARG CUDA_VERSION_MINOR=0
ARG CUDA_VERSION_PATCH=2
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ninja-build \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/cuda-${CUDA_VERSION_MAJOR}.${CUDA_VERSION_MINOR}/compat

WORKDIR /opt/llama.cpp
COPY . /opt/llama.cpp/.
RUN cmake -S . -B build \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=OFF \
    -DLLAMA_BUILD_SERVER=ON \
    -DBUILD_SHARED_LIBS=OFF \
    -DGGML_CUDA=ON \
    -DLLAMA_CURL=ON \
    -G Ninja \
    && cmake --build build --config Release

FROM nvidia/cuda:${CUDA_VERSION_MAJOR}.${CUDA_VERSION_MINOR}.${CUDA_VERSION_PATCH}-runtime-ubuntu24.04 AS production

ARG CUDA_VERSION_MAJOR=13
ARG CUDA_VERSION_MINOR=0
ARG CUDA_VERSION_PATCH=2
ENV DEBIAN_FRONTEND=noninteractive
RUN apt update && apt install -y --no-install-recommends \
    curl \
    build-essential
ENV LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/cuda-${CUDA_VERSION_MAJOR}.${CUDA_VERSION_MINOR}/compat
COPY --from=builder /opt/llama.cpp/build/bin/llama-server /app/llama-server
COPY --from=builder /opt/llama.cpp/build/bin/*.so /app
RUN ldconfig /app
ENTRYPOINT ["/app/llama-server"]