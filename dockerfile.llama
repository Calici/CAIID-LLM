# Build llama.cpp server with CUDA support for production deployments
FROM nvidia/cuda:12.6.2-devel-ubuntu24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        ninja-build \
    && rm -rf /var/lib/apt/lists/*

ENV CUDA_TOOLKIT_ROOT_DIR=/usr/local/cuda

WORKDIR /opt/llama.cpp
COPY llama-cpp/ ./

RUN cmake -S . -B build \
        -DLLAMA_BUILD_TESTS=OFF \
        -DLLAMA_BUILD_EXAMPLES=OFF \
        -DLLAMA_BUILD_SERVER=ON \
        -DGGML_CUDA=ON \
        -DLLAMA_CURL=OFF \
        -G Ninja \
    && cmake --build build --config Release

FROM nvidia/cuda:12.6.2-runtime-ubuntu24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/llama.cpp/build/bin/llama-server /usr/local/bin/llama-server

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/llama-server", "--jinja"]
